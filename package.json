{
	"name": "fs-fixture",
	"version": "0.0.0-semantic-release",
	"description": "Easily create test fixtures at a temporary file-system path",
	"keywords": [
		"test",
		"fixture",
		"temporary",
		"file-system",
		"disk",
		"json",
		"object",
		"template"
	],
	"license": "MIT",
	"repository": "privatenumber/fs-fixture",
	"funding": "https://github.com/privatenumber/fs-fixture?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"imports": {
		"#fs-fixture": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"build": "pkgroll --minify --target=node18",
		"lint": "lintroll --node --cache .",
		"type-check": "tsc",
		"test": "node tests/index.ts",
		"test:custom-fs": "node tests/custom-fs.ts",
		"dev": "node --watch --conditions=development tests/index.ts",
		"prepack": "pnpm build && clean-pkg-json",
		"prepare": "skills-npm"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"@platformatic/vfs": "^0.4.0",
		"@types/node": "^26.4.0",
		"clean-pkg-json": "^2.0.0",
		"lintroll": "^1.31.1",
		"manten": "^2.0.2",
		"pkgroll": "^2.28.1",
		"skills-npm": "^1.2.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3"
	}
}
